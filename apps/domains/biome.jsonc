{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["../../tooling/biome/tanstack-app.jsonc"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    // Biome 2.6.2+ panics ("path is expected to be under the root") when the
    // Tailwind rules follow `@import "@bruhs/theme/..."` out of this app while
    // the ignore file is in use. `files.includes` already limits checks to src/.
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "src/**",
      "!**/.tanstack-start",
      "!**/src/tanstack-start.d.ts",
      "!**/src/styles.css",
      "!**/src/routeTree.gen.ts"
    ]
  }
}
