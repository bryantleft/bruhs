{
  "expo": {
    "name": "bruhs / outside",
    "slug": "bruhs-outside",
    "scheme": "bruhs-outside",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.bruhs.outside"
    },
    "android": {
      "package": "dev.bruhs.outside",
      "permissions": ["android.permission.health.READ_STEPS"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#15110d",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "bruhs / outside"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15110d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Outside reads your daily step totals to pay for your bruh's travel, skills, missions and quests. It never writes to Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-health-rationale.cjs",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your bruh follows your walk. Allow location while using the app to draw your route and earn distance stamps.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-status-bar",
      ["expo-secure-store", { "faceIDPermission": false }]
    ]
  }
}
