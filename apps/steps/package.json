    "balance": "node --experimental-strip-types --no-warnings scripts/balance.ts",
    "sync:brand": "python3 scripts/sync-brand.py",
    "sync:map": "node scripts/sync-map-assets.mjs",
    "postinstall": "node scripts/sync-map-assets.mjs"
