{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["src/**", "app.json", "app.config.ts", "eas.json", "package.json", "metro.config.cjs"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactNativeRawText": { "level": "error", "options": { "skip": ["Copy", "Tag"] } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/+html.tsx"],
      "linter": { "rules": { "correctness": { "noReactNativeRawText": "off" } } }
    }
  ]
}
