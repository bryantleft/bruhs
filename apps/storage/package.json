{
  "name": "storage",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "portless run vite dev",
    "build": "pnpm run build:scanner && vite build",
    "build:scanner": "cargo build --release --manifest-path scanner/Cargo.toml",
    "start": "vite preview",
    "check": "biome check . && pnpm run test",
    "test": "node --test 'tests/*.test.ts'"
  },
  "portless": {
    "name": "storage-bruhs"
  },
  "dependencies": {
    "@bruhs/theme": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "d3-hierarchy": "^3.1.3",
    "lucide-react": "1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "24.19.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "nitro": "3.0.261103-rc",
    "tailwindcss": "^4.3.4"
  }
}
