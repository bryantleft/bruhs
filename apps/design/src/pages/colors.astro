---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ColorCard from "@/components/ColorCard.astro";
import NeutralColorRow from "@/components/NeutralColorRow.astro";
import { accentColors, neutralColors } from "@/data";
---

<BaseLayout title="Colors">
	<div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
		<section>
			<h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Colors</h1>
			<p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
				Seven accents and two warm neutrals. Each OKLCH scale has 11 shades.
				Select a swatch to copy its CSS variable.
			</p>
		</section>
		<section>
			<h2 class="text-h1 font-semibold mb-6 tracking-tight">Accents</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-6">
				{accentColors.map(color => (
					<ColorCard color={color} />
				))}
			</div>
		</section>
		<section>
			<h2 class="text-h1 font-semibold mb-6 tracking-tight">Neutrals</h2>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
				{neutralColors.map(color => (
					<NeutralColorRow color={color} />
				))}
			</div>
		</section>
	</div>
</BaseLayout>
