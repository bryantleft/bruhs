---
import BaseLayout from "@/layouts/BaseLayout.astro";

const patterns = [
  { context: "Icon to text", cls: "gap-1.5", px: 6 },
  { context: "Form label to field", cls: "gap-2", px: 8 },
  { context: "Compact card padding", cls: "p-4", px: 16 },
  { context: "Form field to field", cls: "gap-6", px: 24 },
  { context: "Default card padding", cls: "p-6", px: 24 },
  { context: "Page padding", cls: "p-6 md:p-8", px: 32 },
  { context: "Section to section", cls: "gap-12 md:gap-16", px: 64 },
];
---

<BaseLayout title="Spacing">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Spacing</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Use Tailwind's spacing scale for a consistent rhythm.
        Start with the values below for each layout.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Common values</h2>
      <ul role="list" class="surface-panel divide-y divide-rambutan-100/5 overflow-hidden">
        {patterns.map((p) => (
          <li class="grid gap-x-6 gap-y-3 px-5 py-4 md:grid-cols-[18rem_minmax(0,1fr)] md:items-center">
            <span class="flex flex-col gap-0.5">
              <span class="text-body-sm text-rambutan-200">{p.context}</span>
              <code class="text-code-sm text-rambutan-400">{p.cls}</code>
            </span>
            <span class="flex items-center gap-3">
              <span class="h-4 rounded-seed bg-persimmon-500/30 inset-ring inset-ring-persimmon-400/40" style={`width: ${p.px}px`}></span>
              <span class="text-code-sm text-rambutan-500 tabular-nums">{p.px}px</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <p class="text-body text-rambutan-300 text-pretty">Set <code class="code-inline">gap-*</code> on the parent to space flex or grid children.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use shorthand such as <code class="code-inline">p-4</code>. Split the axes when a breakpoint changes only one.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">--spacing(3)</code> for custom spacing values to stay on the scale.</p>
        <p class="text-body text-rambutan-300 text-pretty">If more space doesn't clarify the grouping, use a divider or a surface.</p>
      </div>
    </section>
  </div>
</BaseLayout>
