---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Example from "@/components/Example.astro";

const plus = `<svg viewBox="0 0 16 16" fill="currentColor" class="size-4 shrink-0"><path d="M8 3a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 8 3Z" /></svg>`;
const chevron = `<svg viewBox="0 0 16 16" fill="currentColor" class="size-4 shrink-0"><path d="M6.47 3.97a.75.75 0 0 1 1.06 0l3.5 3.5a.75.75 0 0 1 0 1.06l-3.5 3.5a.75.75 0 1 1-1.06-1.06L9.44 8l-2.97-2.97a.75.75 0 0 1 0-1.06Z" /></svg>`;
const cross = `<svg viewBox="0 0 16 16" fill="currentColor" class="size-4"><path d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z" /></svg>`;
---

<BaseLayout title="Buttons">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Buttons</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        <code class="code-inline">btn</code> plus one tone. Persimmon is the brand primary: one filled primary per
        page, and every other action uses soft, outline or ghost. Utilities on the same element still win, so
        <code class="code-inline">btn btn-primary w-full</code> works.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Tones</h2>
      <Example code={`<button type="button" class="btn btn-primary">Primary</button>
<button type="button" class="btn btn-soft">Soft</button>
<button type="button" class="btn btn-outline">Outline</button>
<button type="button" class="btn btn-ghost">Ghost</button>
<button type="button" class="btn btn-soft-danger">Soft danger</button>
<button type="button" class="btn btn-danger">Danger</button>`}>
        <button type="button" class="btn btn-primary">Primary</button>
        <button type="button" class="btn btn-soft">Soft</button>
        <button type="button" class="btn btn-outline">Outline</button>
        <button type="button" class="btn btn-ghost">Ghost</button>
        <button type="button" class="btn btn-soft-danger">Soft danger</button>
        <button type="button" class="btn btn-danger">Danger</button>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Sizes and states</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Default is about 36px tall, for form submits and page actions. <code class="code-inline">btn-sm</code> is
        about 28px, for inline actions like "Resend code". Disabled buttons fade and stop reacting to hover.
      </p>
      <Example code={`<button type="button" class="btn btn-primary">Default</button>
<button type="button" class="btn btn-soft btn-sm">Small</button>
<button type="button" class="btn btn-primary" disabled>Disabled</button>`}>
        <button type="button" class="btn btn-primary">Default</button>
        <button type="button" class="btn btn-soft btn-sm">Small</button>
        <button type="button" class="btn btn-primary" disabled>Disabled</button>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">With icons</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Asymmetric padding: the icon side matches the vertical padding. <code class="code-inline">btn-icon</code> is
        square and gets an invisible 48px hit area on touch screens; give it an <code class="code-inline">aria-label</code>.
      </p>
      <Example code={`<button type="button" class="btn btn-primary pl-2">${plus} New item</button>
<button type="button" class="btn btn-outline pr-2">Continue ${chevron}</button>
<button type="button" class="btn btn-ghost btn-icon" aria-label="Close">${cross}</button>`}>
        <button type="button" class="btn btn-primary pl-2"><Fragment set:html={plus} /> New item</button>
        <button type="button" class="btn btn-outline pr-2">Continue <Fragment set:html={chevron} /></button>
        <button type="button" class="btn btn-ghost btn-icon" aria-label="Close"><Fragment set:html={cross} /></button>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <ul role="list" class="flex flex-col gap-3 max-w-[72ch]">
        <li class="text-body text-rambutan-300 text-pretty">Only one filled button per page. Dialogs count as their own page.</li>
        <li class="text-body text-rambutan-300 text-pretty">Secondary buttons must never be higher contrast than the primary.</li>
        <li class="text-body text-rambutan-300 text-pretty">Destructive actions use <code class="code-inline">btn-soft-danger</code> unless deleting is the point of the page or dialog; then <code class="code-inline">btn-danger</code>.</li>
        <li class="text-body text-rambutan-300 text-pretty">Links styled as buttons keep <code class="code-inline">&lt;a&gt;</code>; buttons that navigate are a bug.</li>
        <li class="text-body text-rambutan-300 text-pretty">The focus ring comes from the theme. Don't restate it per button.</li>
      </ul>
    </section>
  </div>
</BaseLayout>
