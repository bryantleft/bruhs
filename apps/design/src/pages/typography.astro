---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FontSample from "@/components/FontSample.astro";
import TypographyScale from "@/components/TypographyScale.astro";
import { fonts, typographyScale, typographyCategories } from "@/data";
---

<BaseLayout title="Typography">
	<div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
		<section>
			<h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Typography</h1>
			<p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
				Bruhs is all mono. Every piece of text, from prose to headings, buttons and code, is set in a
				<a href="https://monaspace.githubnext.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-rambutan-100 hover:text-rambutan-50 underline decoration-rambutan-100/20 hover:decoration-rambutan-100/40 transition-colors">Monaspace</a>
				variant, and each variant has one job. Click a row to copy its class.
			</p>
		</section>

		<section>
			<h2 class="text-h1 font-semibold mb-6 tracking-tight">Families</h2>
			<ul role="list" class="divide-y divide-rambutan-100/5 overflow-hidden rounded-lychee bg-longan-900 inset-ring inset-ring-rambutan-100/5">
				{fonts.map(font => (
					<li><FontSample name={font.name} variable={font.var} className={font.className} /></li>
				))}
			</ul>
		</section>

		<section>
			<h2 class="text-h1 font-semibold mb-2 tracking-tight">Scale</h2>
			<p class="text-body text-rambutan-400 mb-8 max-w-[65ch] text-pretty">
				Seven roles, each bound to one variant. Reach for the class that matches the role.
			</p>
			<div class="flex flex-col gap-10">
				{typographyCategories.map(category => (
					<TypographyScale
						items={typographyScale[category.key]}
						title={category.title}
						description={category.description}
					/>
				))}
			</div>
		</section>
	</div>
</BaseLayout>
