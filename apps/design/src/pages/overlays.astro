---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Example from "@/components/Example.astro";

const layers = [
  { name: "z-raised", value: 10, use: "Focused cards and sticky table cells" },
  { name: "z-sticky", value: 20, use: "Sticky headers and toolbars" },
  { name: "z-overlay", value: 40, use: "Backdrops behind overlays" },
  { name: "z-modal", value: 50, use: "Custom drawers and modals" },
  { name: "z-popover", value: 60, use: "Menus and command palettes above modals" },
  { name: "z-toast", value: 70, use: "Toasts and live notifications" },
  { name: "z-tooltip", value: 80, use: "Tooltips above other named layers" },
];
---

<BaseLayout title="Overlays">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Overlays</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Use native <code class="code-inline">&lt;dialog&gt;</code> and <code class="code-inline">popover</code> elements where possible.
        The browser places them in the top layer, above the page's stacking order.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Dialog</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Add <code class="code-inline">dialog</code> and open it with <code class="code-inline">showModal()</code>.
        The class provides the surface and backdrop. Its entrance animation respects reduced motion.
        Escape or a form with <code class="code-inline">method="dialog"</code> closes it.
      </p>
      <Example code={`<button type="button" class="btn btn-outline" onclick="trash.showModal()">Delete file</button>
<dialog id="trash" class="dialog" aria-labelledby="trash-title">
  <form method="dialog" class="flex flex-col gap-4">
    <h2 id="trash-title" class="text-h3">Move to Trash?</h2>
    <p class="text-body-sm text-rambutan-400">You can restore the file until you empty the Trash.</p>
    <div class="flex justify-end gap-3">
      <button value="cancel" class="btn btn-ghost">Cancel</button>
      <button value="confirm" class="btn btn-danger">Move to Trash</button>
    </div>
  </form>
</dialog>`}>
        <button type="button" class="btn btn-outline" data-open-dialog="demo-dialog">Delete file</button>
        <dialog id="demo-dialog" class="dialog" aria-labelledby="demo-dialog-title">
          <form method="dialog" class="flex flex-col gap-4">
            <h2 id="demo-dialog-title" class="text-h3">Move to Trash?</h2>
            <p class="text-body-sm text-rambutan-400">You can restore the file until you empty the Trash.</p>
            <div class="flex justify-end gap-3">
              <button value="cancel" class="btn btn-ghost">Cancel</button>
              <button value="confirm" class="btn btn-danger">Move to Trash</button>
            </div>
          </form>
        </dialog>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Menu</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Use <code class="code-inline">popover</code> for the surface and <code class="code-inline">menu-item</code> for each row.
        Rows highlight on hover or when marked as active. The example stays open to show the styles.
        In an app, use a <code class="code-inline">[popover]</code> element.
      </p>
      <Example previewClass="flex" code={`<div class="popover w-64" role="menu" aria-label="File">
  <button type="button" class="menu-item" role="menuitem">Rename</button>
  <button type="button" class="menu-item" role="menuitem" data-highlighted>Duplicate</button>
  <button type="button" class="menu-item" role="menuitem" aria-disabled="true">Share</button>
  <div class="my-1 border-t border-rambutan-100/10" role="separator"></div>
  <button type="button" class="menu-item text-lychee-300" role="menuitem">Move to Trash</button>
</div>`}>
        <div class="popover w-64" role="menu" aria-label="File">
          <button type="button" class="menu-item" role="menuitem">Rename</button>
          <button type="button" class="menu-item" role="menuitem" data-highlighted>Duplicate</button>
          <button type="button" class="menu-item" role="menuitem" aria-disabled="true">Share</button>
          <div class="my-1 border-t border-rambutan-100/10" role="separator"></div>
          <button type="button" class="menu-item text-lychee-300" role="menuitem">Move to Trash</button>
        </div>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Tooltip</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Use <code class="code-inline">tooltip</code> for the bubble. Show it on hover and keyboard focus.
        Label the trigger with <code class="code-inline">aria-label</code> or connect it to the tooltip with <code class="code-inline">aria-describedby</code>.
      </p>
      <Example previewClass="flex pt-14" code={`<button type="button" class="group relative btn btn-ghost btn-icon" aria-describedby="tip-copy">
  <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true">…</svg>
  <span id="tip-copy" role="tooltip" class="tooltip absolute bottom-full left-1/2 mb-2 -translate-x-1/2 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
    Copy link
  </span>
</button>`}>
        <button type="button" class="group relative btn btn-ghost btn-icon" aria-describedby="demo-tip">
          <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true">
            <path d="M8.914 6.025a.75.75 0 0 1 1.06 0 3.5 3.5 0 0 1 0 4.95l-2 2a3.5 3.5 0 0 1-5.396-4.402.75.75 0 0 1 1.251.827 2 2 0 0 0 3.085 2.514l2-2a2 2 0 0 0 0-2.828.75.75 0 0 1 0-1.06Z" />
            <path d="M7.086 9.975a.75.75 0 0 1-1.06 0 3.5 3.5 0 0 1 0-4.95l2-2a3.5 3.5 0 0 1 5.396 4.402.75.75 0 0 1-1.251-.827 2 2 0 0 0-3.085-2.514l-2 2a2 2 0 0 0 0 2.828.75.75 0 0 1 0 1.06Z" />
          </svg>
          <span id="demo-tip" role="tooltip" class="tooltip absolute bottom-full left-1/2 mb-2 -translate-x-1/2 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
            Copy link
          </span>
        </button>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Layers</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Use a named layer when the browser's top layer isn't available.
        The values set the stacking order. Use variables such as <code class="code-inline">--z-popover</code> in plain CSS.
      </p>
      <ul role="list" class="surface-panel divide-y divide-rambutan-100/5 overflow-hidden">
        {layers.map((l) => (
          <li class="grid gap-x-6 gap-y-1 px-5 py-3 md:grid-cols-[10rem_3rem_minmax(0,1fr)] md:items-center">
            <code class="text-code text-rambutan-100">{l.name}</code>
            <span class="text-code-sm text-rambutan-500 tabular-nums">{l.value}</span>
            <span class="text-body-sm text-rambutan-400">{l.use}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    for (const trigger of document.querySelectorAll<HTMLElement>("[data-open-dialog]")) {
      const dialog = document.getElementById(trigger.dataset.openDialog ?? "");
      if (dialog instanceof HTMLDialogElement) trigger.addEventListener("click", () => dialog.showModal());
    }
  });
</script>
