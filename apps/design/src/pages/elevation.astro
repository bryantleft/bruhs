---
import BaseLayout from "@/layouts/BaseLayout.astro";

const steps = [
  { name: "Canvas", cls: "bg-longan-950 rounded-lychee inset-ring inset-ring-white/5", label: "body", note: "The page itself. Zero elevation; the theme sets it on <body>." },
  { name: "Panel", cls: "surface-panel", label: "surface-panel", note: "Ambient containers: nav, sidebar, hero frames." },
  { name: "Card", cls: "surface-card", label: "surface-card", note: "Independently interactive, one step above canvas." },
  { name: "Floating", cls: "surface-floating", label: "surface-floating", note: "Popovers, menus, tooltips. Lifted two steps." },
  { name: "Modal", cls: "surface-modal", label: "surface-modal", note: "Dialogs, against a longan-950/70 scrim." },
  { name: "Well", cls: "surface-well", label: "surface-well", note: "Recessed: nested or secondary content." },
];
---

<BaseLayout title="Elevation">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Elevation</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Bruhs has no <code class="code-inline">shadow-*</code>. Elevation is expressed with two levers:
        a tone step in the <span class="code-inline">longan</span> neutral and a matching
        <code class="code-inline">inset-ring</code>. The <code class="code-inline">surface-*</code> classes bundle both, so you pick a
        rung instead of a pair of values.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Ladder</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Add <code class="code-inline">surface-interactive</code> to a clickable surface and its ring lifts one step on hover.
      </p>
      <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {steps.map(s => (
          <li class={`p-6 ${s.cls}`}>
            <p class="flex items-baseline justify-between gap-3">
              <span class="text-label text-rambutan-100">{s.name}</span>
              <code class="text-code-sm text-rambutan-400">{s.label}</code>
            </p>
            <p class="text-body-sm text-rambutan-400 mt-1">{s.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Bloom</h2>
      <p class="text-body-sm text-rambutan-400 mb-4 max-w-[65ch] text-pretty">
        The one exception — a persimmon glow reserved for focus, active, and "something happened here" accents.
      </p>
      <div class="rounded-lychee p-8 bg-longan-900 inset-ring inset-ring-white/5 flex items-center justify-center gap-6">
        <button type="button" class="rounded-grape bg-persimmon-500 px-4 py-2 text-button text-longan-950 ring-1 ring-persimmon-500 [box-shadow:var(--shadow-bloom)]">
          Focused
        </button>
        <div class="size-12 rounded-orb bg-persimmon-500 [box-shadow:var(--shadow-bloom)]"></div>
      </div>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <ul role="list" class="flex flex-col gap-3 max-w-[72ch]">
        <!-- bruhs-theme-ignore: this rule names the banned shadow classes -->
        <li class="text-body text-rambutan-300 text-pretty">Never use <code class="code-inline">shadow-xs</code> through <code class="code-inline">shadow-2xl</code>. They are not defined in Bruhs.</li>
        <li class="text-body text-rambutan-300 text-pretty">Elevate by stepping the background tone (<code class="code-inline">longan-950 → 900 → 800 → 700</code>) and widening the inset-ring in parallel (<code class="code-inline">white/5 → /10 → /15 → /20</code>).</li>
        <li class="text-body text-rambutan-300 text-pretty"><code class="code-inline">--shadow-bloom</code> is allowed only for focus states, active triggers, or deliberate attention accents.</li>
        <li class="text-body text-rambutan-300 text-pretty">Modals use a <code class="code-inline">longan-950/70</code> scrim — never pure <code class="code-inline">black/*</code>.</li>
      </ul>
    </section>
  </div>
</BaseLayout>
