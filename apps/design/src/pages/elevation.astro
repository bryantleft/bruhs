---
import BaseLayout from "@/layouts/BaseLayout.astro";

const steps = [
  { name: "Canvas", cls: "bg-longan-950 rounded-lychee inset-ring inset-ring-white/5", label: "body", note: "The page background, set by the theme." },
  { name: "Panel", cls: "surface-panel", label: "surface-panel", note: "Containers for navigation and supporting content." },
  { name: "Card", cls: "surface-card", label: "surface-card", note: "Separate or interactive content above the panel tone." },
  { name: "Floating", cls: "surface-floating", label: "surface-floating", note: "Menus and popovers above the card tone." },
  { name: "Modal", cls: "surface-modal", label: "surface-modal", note: "Dialogs shown over a dimmed backdrop." },
  { name: "Well", cls: "surface-well", label: "surface-well", note: "Recessed areas for nested or secondary content." },
];
---

<BaseLayout title="Elevation">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Elevation</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Show depth with background tones and inset rings.
        Choose a <code class="code-inline">surface-*</code> class to set both together.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Surface levels</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Add <code class="code-inline">surface-interactive</code> to a clickable surface.
        Its ring becomes more visible on hover.
      </p>
      <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {steps.map(s => (
          <li class={`p-6 ${s.cls}`}>
            <p class="flex items-baseline justify-between gap-3">
              <span class="text-label text-rambutan-100">{s.name}</span>
              <code class="text-code-sm text-rambutan-400">{s.label}</code>
            </p>
            <p class="text-body-sm text-rambutan-400 mt-1">{s.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Bloom</h2>
      <p class="text-body-sm text-rambutan-400 mb-4 max-w-[65ch] text-pretty">
        Use the persimmon glow for focus or an active control.
        Reserve it for moments that need attention.
      </p>
      <div class="rounded-lychee p-8 bg-longan-900 inset-ring inset-ring-white/5 flex items-center justify-center gap-6">
        <button type="button" class="rounded-grape bg-persimmon-500 px-4 py-2 text-button text-longan-950 ring-1 ring-persimmon-500 [box-shadow:var(--shadow-bloom)]">
          Focused
        </button>
        <div class="size-12 rounded-orb bg-persimmon-500 [box-shadow:var(--shadow-bloom)]"></div>
      </div>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <!-- bruhs-theme-ignore: this rule names the banned shadow classes -->
        <p class="text-body text-rambutan-300 text-pretty">Use tone and ring for depth. Bruhs omits <code class="code-inline">shadow-xs</code> through <code class="code-inline">shadow-2xl</code>.</p>
        <p class="text-body text-rambutan-300 text-pretty">As a surface rises, lighten its background and strengthen its inset ring.</p>
        <p class="text-body text-rambutan-300 text-pretty">Reserve <code class="code-inline">--shadow-bloom</code> for focus, active controls or deliberate attention.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">longan-950/70</code> for modal backdrops.</p>
      </div>
    </section>
  </div>
</BaseLayout>
