---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Icons">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Icons</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Use <a href="https://heroicons.com" class="text-persimmon-300 underline decoration-persimmon-400/30 hover:decoration-persimmon-400">Heroicons</a>
        at their native sizes. Match each icon's viewBox to its size class.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Sizing</h2>
      <div class="rounded-lychee border border-rambutan-100/5 bg-longan-900 p-6">
        <ul role="list" class="flex flex-col gap-6">
          <li class="flex items-center gap-4">
            <svg viewBox="0 0 16 16" fill="currentColor" class="size-4 h-lh shrink-0 text-persimmon-300">
              <path d="M8 2.5a.75.75 0 0 1 .75.75v4h4a.75.75 0 0 1 0 1.5h-4v4a.75.75 0 0 1-1.5 0v-4h-4a.75.75 0 0 1 0-1.5h4v-4A.75.75 0 0 1 8 2.5Z" />
            </svg>
            <div class="min-w-0">
              <p class="text-label text-rambutan-100">Micro (16px)</p>
              <p class="text-body-sm text-rambutan-400">Use <code class="code-inline">size-4</code> in app interfaces and beside <code class="code-inline">text-body-sm</code>.</p>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-5 shrink-0 text-persimmon-300">
              <path d="M10 3a.75.75 0 0 1 .75.75v5.5h5.5a.75.75 0 0 1 0 1.5h-5.5v5.5a.75.75 0 0 1-1.5 0v-5.5h-5.5a.75.75 0 0 1 0-1.5h5.5v-5.5A.75.75 0 0 1 10 3Z" />
            </svg>
            <div class="min-w-0">
              <p class="text-label text-rambutan-100">Mini (20px)</p>
              <p class="text-body-sm text-rambutan-400">Use <code class="code-inline">size-5</code> for navigation and marketing pages.</p>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 shrink-0 text-persimmon-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <div class="min-w-0">
              <p class="text-label text-rambutan-100">Outline (24px)</p>
              <p class="text-body-sm text-rambutan-400">Use <code class="code-inline">size-6</code> for hero illustrations and feature rows.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <p class="text-body text-rambutan-300 text-pretty">Choose the icon set that matches the required size. Keep its native dimensions.</p>
        <p class="text-body text-rambutan-300 text-pretty">Place icons directly in the layout. Skip decorative boxes and circles behind them.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">fill-*</code> for filled icons and <code class="code-inline">stroke-*</code> for outlines.</p>
        <p class="text-body text-rambutan-300 text-pretty">Add <code class="code-inline">shrink-0</code> inside flex containers. Use <code class="code-inline">h-lh</code> to align with adjacent text.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">btn-icon</code> for buttons that show only an icon. It adds a 48px touch target.</p>
      </div>
    </section>
  </div>
</BaseLayout>
