---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Example from "@/components/Example.astro";
---

<BaseLayout title="Feedback">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Feedback</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Tell people when work is in progress or content is missing.
        Explain errors and give a useful next action.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Spinner</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Set the spinner's size with <code class="code-inline">size-*</code> and its color with a text color class.
        Use <code class="code-inline">--spinner-width</code> to adjust the stroke.
        Add a visible label or label its button. The spinner slows down for reduced motion.
      </p>
      <Example code={`<span class="spinner size-4 text-rambutan-400" aria-hidden="true"></span>
<span class="spinner size-6 text-persimmon-400 [--spinner-width:3px]" aria-hidden="true"></span>
<button type="button" class="btn btn-primary pl-2" disabled>
  <span class="spinner size-4" aria-hidden="true"></span> Scanning…
</button>`}>
        <span class="spinner size-4 text-rambutan-400" aria-hidden="true"></span>
        <span class="spinner size-6 text-persimmon-400 [--spinner-width:3px]" aria-hidden="true"></span>
        <button type="button" class="btn btn-primary pl-2" disabled>
          <span class="spinner size-4" aria-hidden="true"></span> Scanning…
        </button>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-2">Empty state</h2>
      <p class="text-body text-rambutan-400 mb-6 max-w-[65ch] text-pretty">
        Use <code class="code-inline">empty-state</code> to center a message and one action.
        Say what's missing and what to do next. Add <code class="code-inline">min-h-dvh</code> for a full page.
      </p>
      <Example previewClass="" code={`<div class="empty-state">
  <p class="text-eyebrow text-rambutan-500">No scans yet</p>
  <h2 class="text-h3">Pick a folder to see what's using space</h2>
  <p class="text-body-sm">Choose a folder to start your first scan.</p>
  <button type="button" class="btn btn-primary mt-4">Choose folder</button>
</div>`}>
        <div class="empty-state">
          <p class="text-eyebrow text-rambutan-500">No scans yet</p>
          <h2 class="text-h3">Pick a folder to see what's using space</h2>
          <p class="text-body-sm">Choose a folder to start your first scan.</p>
          <button type="button" class="btn btn-primary mt-4">Choose folder</button>
        </div>
      </Example>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <p class="text-body text-rambutan-300 text-pretty">Show a spinner after a short wait. Skip it when the work finishes immediately.</p>
        <p class="text-body text-rambutan-300 text-pretty">Say what failed and how to fix it.</p>
        <p class="text-body text-rambutan-300 text-pretty">Give each empty state one action. If no action is available, explain when the content will appear.</p>
      </div>
    </section>
  </div>
</BaseLayout>
