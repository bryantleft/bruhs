---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Example from "@/components/Example.astro";

const meterCode = `<span class="braille-meter" role="meter" aria-label="Microphone and system audio">
  <i></i><i></i><i data-lit></i><i data-lit></i>
  <i></i><i></i><i></i><i data-lit></i>
</span>`;
const ruleCode = `<hr class="dither-rule">`;
---

<BaseLayout title="Dither">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Dither</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        The brand texture: the Bruh and small indicators drawn in dots. The Bruh is a halftone, every dot sized
        by the light on a sphere, so the face reads as a lit ball; the level meter is one braille cell. Keep it
        for brand moments, never for app chrome.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Bruh</h2>
      <div class="surface-panel grid place-items-center p-6">
        <canvas class="w-full max-w-[22rem] aspect-square" data-dither-bruh aria-hidden="true"></canvas>
      </div>
      <p class="mt-4 text-body-sm text-rambutan-400 max-w-[65ch]">
        <code class="code-inline">bruhDots()</code> from <code class="code-inline">@bruhs/theme/dither</code> reads the
        logo's geometry, so the dots always match it. Move the pointer: <code class="code-inline">lookX</code> turns the
        face toward the logo's <code class="code-inline">left</code> and <code class="code-inline">right</code> variants.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Level meter</h2>
      <Example code={meterCode} previewClass="flex items-center gap-4">
        <span class="braille-meter" role="meter" aria-label="Microphone and system audio" data-dither-meter>
          <i></i><i></i><i data-lit></i><i data-lit></i>
          <i></i><i></i><i></i><i data-lit></i>
        </span>
        <span class="text-body-sm text-rambutan-400">Microphone left, system audio right</span>
      </Example>
      <p class="mt-4 text-body-sm text-rambutan-400 max-w-[65ch]">
        <code class="code-inline">meterDots(level)</code> turns a level in 0 to 1 into lit dots, square-rooted so quiet speech
        still shows.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rule</h2>
      <Example code={ruleCode} previewClass="block">
        <hr class="dither-rule" />
      </Example>
    </section>
  </div>
</BaseLayout>

<script>
  import { bruhDots, drawDots, meterDots, type BrailleBruh } from "@bruhs/theme/dither";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const canvas = document.querySelector<HTMLCanvasElement>("[data-dither-bruh]");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    const css = getComputedStyle(document.documentElement);
    const colors = {
      face: css.getPropertyValue("--color-bruh-base").trim(),
      mouth: css.getPropertyValue("--color-bruh-mouth").trim(),
    };
    let face: BrailleBruh = { cx: 0, cy: 0, r: 1 };
    let size = 0;
    const draw = () => {
      drawDots(ctx, size, size, bruhDots(size, size, face), colors);
    };
    new ResizeObserver(() => {
      size = canvas.clientWidth;
      const scale = Math.min(devicePixelRatio || 1, 2);
      canvas.width = canvas.height = Math.round(size * scale);
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      face = { ...face, cx: size / 2, cy: size / 2, r: size * 0.42 };
      draw();
    }).observe(canvas);
    let frame = 0;
    document.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse" || reduced) return;
      const rect = canvas.getBoundingClientRect();
      const lookX = Math.max(-1, Math.min(1, (event.clientX - rect.left - face.cx) / 480));
      const lookY = Math.max(-1, Math.min(1, (event.clientY - rect.top - face.cy) / 360));
      face = { ...face, lookX, lookY };
      frame ||= requestAnimationFrame(() => {
        frame = 0;
        draw();
      });
    });
  }

  // A sample level so the meter has something to show.
  const meter = document.querySelector("[data-dither-meter]");
  if (meter && !reduced) {
    const dots = [...meter.children];
    setInterval(() => {
      const t = performance.now() / 1000;
      const levels = [Math.abs(Math.sin(t * 2.3)) * 0.8, Math.abs(Math.sin(t * 1.1 + 1)) * 0.5];
      levels.forEach((level, column) => {
        const lit = meterDots(level);
        for (let i = 0; i < 4; i++) dots[column * 4 + i]?.toggleAttribute("data-lit", 3 - i < lit);
      });
    }, 120);
  }
</script>
