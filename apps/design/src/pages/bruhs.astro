---
import { codeToHtml } from "shiki";
import LogoShowcase from "@/components/LogoShowcase";
import { colorVariations, logoVariants, type ResolvedColorVariation } from "@/data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildLogoCode, LOGO_CODE_PLACEHOLDERS } from "@/utils/logo-code";
import { colorToken } from "@/utils/theme-tokens";

// Resolve colour tokens and highlight the code sample here, at build time, so the
// island ships neither the theme stylesheet nor shiki.
const colors: ResolvedColorVariation[] = colorVariations.map((c) => ({
  id: c.id,
  name: c.name,
  baseColor: colorToken(c.base),
  eyeColor: colorToken(c.eyes),
  mouthColor: colorToken(c.mouth),
}));
const code = buildLogoCode(LOGO_CODE_PLACEHOLDERS);
const html = await codeToHtml(code, { lang: "tsx", theme: "github-dark" });
---

<BaseLayout title="Logo">
  <div class="flex flex-col gap-8 p-6 md:p-8">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Logo</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        The Bruhs face comes in three eye positions and eight palettes. Pick one, then switch to Code for a
        dependency-free React component.
      </p>
    </section>
    <LogoShowcase client:visible variants={logoVariants} colors={colors} codeTemplate={{ code, html }} />
  </div>
</BaseLayout>
