---
import BaseLayout from "@/layouts/BaseLayout.astro";

const durations = [
  { name: "duration-blink", ms: "80ms", cls: "duration-blink", use: "Brief selection feedback" },
  { name: "duration-fast", ms: "150ms", cls: "duration-fast", use: "Hover and press feedback. The default duration." },
  { name: "duration-standard", ms: "250ms", cls: "duration-standard", use: "Content entering or changing size" },
  { name: "duration-slow", ms: "400ms", cls: "duration-slow", use: "Page transitions and large panels" },
  { name: "duration-bloom", ms: "600ms", cls: "duration-bloom", use: "Deliberate brand accents" },
];

const easings = [
  { name: "ease-standard", curve: "cubic-bezier(0.2, 0, 0, 1)", cls: "ease-standard", use: "Most UI transitions" },
  { name: "ease-entrance", curve: "cubic-bezier(0, 0, 0, 1)", cls: "ease-entrance", use: "Content entering view" },
  { name: "ease-exit", curve: "cubic-bezier(0.23, 1, 0.32, 1)", cls: "ease-exit", use: "Content leaving view" },
  { name: "ease-bloom", curve: "cubic-bezier(0.34, 1.56, 0.64, 1)", cls: "ease-bloom", use: "Playful overshoot for brand accents" },
];
---

<BaseLayout title="Motion">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Motion</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Use the motion tokens to keep transitions consistent.
        The default <code class="code-inline">transition</code> uses <code class="code-inline">duration-fast</code> with
        <code class="code-inline">ease-standard</code>. Hover over a row to preview its motion.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Durations</h2>
      <ul role="list" class="surface-panel divide-y divide-rambutan-100/5 overflow-hidden">
        {durations.map((d) => (
          <li class="group grid gap-x-6 gap-y-3 px-5 py-4 md:grid-cols-[14rem_minmax(0,1fr)] md:items-center">
            <span class="flex flex-col gap-0.5">
              <code class="text-code text-rambutan-100">{d.name}</code>
              <span class="text-body-sm text-rambutan-400 tabular-nums">{d.ms}. {d.use}</span>
            </span>
            <span class="relative h-2 rounded-orb bg-white/5">
              <span class:list={["absolute inset-y-0 left-0 w-3 rounded-orb bg-persimmon-500 transition-[left] ease-standard motion-safe:group-hover:left-[calc(100%-0.75rem)]", d.cls]}></span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Easings</h2>
      <ul role="list" class="surface-panel divide-y divide-rambutan-100/5 overflow-hidden">
        {easings.map((e) => (
          <li class="group grid gap-x-6 gap-y-3 px-5 py-4 md:grid-cols-[14rem_minmax(0,1fr)] md:items-center">
            <span class="flex flex-col gap-0.5">
              <code class="text-code text-rambutan-100">{e.name}</code>
              <span class="text-body-sm text-rambutan-400">{e.use}</span>
              <code class="text-code-sm text-rambutan-500">{e.curve}</code>
            </span>
            <span class="relative h-2 rounded-orb bg-white/5">
              <span class:list={["absolute inset-y-0 left-0 w-3 rounded-orb bg-blueberry-400 transition-[left] duration-slow motion-safe:group-hover:left-[calc(100%-0.75rem)]", e.cls]}></span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <!-- bruhs-theme-ignore: names the classes this rule bans -->
        <p class="text-body text-rambutan-300 text-pretty">Name the property with <code class="code-inline">transition-colors</code> or <code class="code-inline">transition-[translate]</code>. Avoid <code class="code-inline">transition-all</code>.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">ease-entrance</code> when opening and <code class="code-inline">ease-exit</code> when closing. Both start fast and settle, so motion answers at once.</p>
        <p class="text-body text-rambutan-300 text-pretty">Wrap decorative motion in <code class="code-inline">motion-safe:</code>. A spinner may keep moving at a slower speed.</p>
        <p class="text-body text-rambutan-300 text-pretty">Keep frequent and keyboard actions immediate. Keep routine transitions under 300ms.</p>
        <!-- bruhs-theme-ignore: names the classes this rule bans -->
        <p class="text-body text-rambutan-300 text-pretty">Use named motion tokens. The theme checker rejects raw values such as <code class="code-inline">duration-300</code> and <code class="code-inline">ease-in-out</code>.</p>
      </div>
    </section>
  </div>
</BaseLayout>
