---
import BaseLayout from "@/layouts/BaseLayout.astro";

const radii = [
  { name: "seed", className: "rounded-seed", size: "0.25rem (4px)", usage: "Tags and compact controls" },
  { name: "grape", className: "rounded-grape", size: "0.5rem (8px)", usage: "Buttons and form controls" },
  { name: "lychee", className: "rounded-lychee", size: "0.875rem (14px)", usage: "Cards and panels" },
  { name: "mango", className: "rounded-mango", size: "1.375rem (22px)", usage: "Hero tiles and media" },
  { name: "pomelo", className: "rounded-pomelo", size: "2.25rem (36px)", usage: "Marketing blocks and pull quotes" },
  { name: "orb", className: "rounded-orb", size: "9999px", usage: "Circular and pill shapes" },
];
---

<BaseLayout title="Radius">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Radius</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Choose from six corner sizes named after fruit.
        Use the same scale for controls and containers.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Scale</h2>
      <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {radii.map(r => (
          <li class="flex items-center gap-5 p-5 rounded-grape inset-ring inset-ring-rambutan-100/5 bg-longan-900">
            <div class={`${r.className} size-16 shrink-0 bg-persimmon-500/20 inset-ring inset-ring-persimmon-400/30`} />
            <div class="min-w-0">
              <p class="text-label text-rambutan-100">{r.className}</p>
              <p class="text-body-sm text-rambutan-400">{r.size}</p>
              <p class="text-body-sm text-rambutan-500">{r.usage}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Concentric nesting</h2>
      <p class="text-body-sm text-rambutan-400 mb-4 max-w-[65ch] text-pretty">
        Subtract the padding from the outer radius to get the inner radius.
        This keeps nested corners parallel.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-mango p-4 bg-longan-900 inset-ring inset-ring-rambutan-100/5 [--radius:var(--radius-mango)] [--padding:--spacing(4)]">
          <div class="rounded-[calc(var(--radius)-var(--padding))] bg-persimmon-500/15 inset-ring inset-ring-persimmon-400/20 p-4">
            <p class="text-body-sm text-rambutan-200">Inner radius follows the outer curve</p>
          </div>
        </div>
        <div class="rounded-mango p-4 bg-longan-900 inset-ring inset-ring-rambutan-100/5">
          <div class="rounded-mango bg-lychee-500/15 inset-ring inset-ring-lychee-400/20 p-4">
            <p class="text-body-sm text-rambutan-200">Inner radius is too large</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <!-- bruhs-theme-ignore: this rule names the banned radius classes -->
        <p class="text-body text-rambutan-300 text-pretty">Use the fruit radius classes. Tailwind defaults such as <code class="code-inline">rounded-md</code> and <code class="code-inline">rounded-xl</code> aren't part of Bruhs.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use CSS variables to calculate nested corners, as shown above.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">rounded-orb</code> for circular shapes and pills.</p>
      </div>
    </section>
  </div>
</BaseLayout>
