---
import BaseLayout from "@/layouts/BaseLayout.astro";

const tile =
  "group block rounded-lychee bg-longan-900 p-5 inset-ring inset-ring-rambutan-100/5 transition-colors hover:bg-longan-800 hover:inset-ring-rambutan-100/15 focus-visible:outline-2 focus-visible:outline-persimmon-400";
---

<BaseLayout>
  <div class="p-6 md:p-8 flex flex-col gap-8">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2">Bruhs</h1>
      <p class="text-body-lg text-rambutan-400">
        A
        <a href="https://bnle.me" class="font-medium text-rambutan-200 hover:text-rambutan-100 underline decoration-rambutan-100/20 hover:decoration-rambutan-100/40 transition-colors">
          personal
        </a>
        design system with colors named after fruit and type set in Monaspace.
      </p>
    </section>

    <section>
      <h2 class="text-label-sm text-rambutan-500 mb-3">Foundations</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <a href="/colors" class={tile}>
        <div class="flex gap-1 mb-4 h-8">
          <div class="flex-1 rounded-l-grape bg-lychee-500"></div>
          <div class="flex-1 bg-persimmon-500"></div>
          <div class="flex-1 bg-durian-500"></div>
          <div class="flex-1 bg-pandan-500"></div>
          <div class="flex-1 bg-blueberry-500"></div>
          <div class="flex-1 bg-mangosteen-500"></div>
          <div class="flex-1 rounded-r-grape bg-dragonfruit-500"></div>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Colors</h3>
        <p class="text-body-sm text-rambutan-400">Seven accents and two warm neutrals in OKLCH</p>
      </a>
      <a href="/typography" class={tile}>
        <div class="mb-4 h-8 flex items-end gap-2 overflow-hidden">
          <span class="text-h2 leading-none text-rambutan-300" style="font-family: var(--font-krypton)">Kr</span>
          <span class="text-h3 leading-none text-rambutan-400" style="font-family: var(--font-xenon)">Xe</span>
          <span class="text-h4 leading-none text-rambutan-500" style="font-family: var(--font-neon)">Ne</span>
          <span class="text-body leading-none text-rambutan-500" style="font-family: var(--font-argon)">Ar</span>
          <span class="text-body leading-none text-rambutan-600" style="font-family: var(--font-radon)">Ra</span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Typography</h3>
        <p class="text-body-sm text-rambutan-400">A Monaspace family for each text role</p>
      </a>
      <a href="/radius" class={tile}>
        <div class="mb-4 h-8 flex items-end gap-2" aria-hidden="true">
          <div class="size-8 rounded-tl-seed border-t-2 border-l-2 border-persimmon-400/70"></div>
          <div class="size-8 rounded-tl-grape border-t-2 border-l-2 border-persimmon-400/70"></div>
          <div class="size-8 rounded-tl-lychee border-t-2 border-l-2 border-persimmon-400/70"></div>
          <div class="size-8 rounded-tl-mango border-t-2 border-l-2 border-persimmon-400/70"></div>
          <div class="size-8 rounded-tl-orb border-t-2 border-l-2 border-persimmon-400/70"></div>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Radius</h3>
        <p class="text-body-sm text-rambutan-400">Six corner sizes named after fruit</p>
      </a>
      <a href="/elevation" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-3">
          <div class="size-6 rounded-grape bg-longan-900 inset-ring inset-ring-white/5"></div>
          <div class="size-6 rounded-grape bg-longan-800 inset-ring inset-ring-white/10"></div>
          <div class="size-6 rounded-grape bg-longan-700 inset-ring inset-ring-white/15"></div>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Elevation</h3>
        <p class="text-body-sm text-rambutan-400">Depth through background tones and inset rings</p>
      </a>
      <a href="/surfaces" class={tile}>
        <div class="mb-4 h-8 grid grid-cols-3 gap-2" aria-hidden="true">
          <div class="flex flex-col justify-center gap-1.5"><span class="h-1 w-3/4 rounded-orb bg-rambutan-100/30"></span><span class="h-1 w-1/2 rounded-orb bg-rambutan-100/15"></span></div>
          <div class="flex flex-col justify-center gap-1.5"><span class="h-1 w-3/4 rounded-orb bg-rambutan-100/30"></span><span class="border-t border-rambutan-100/20"></span><span class="h-1 w-1/2 rounded-orb bg-rambutan-100/15"></span></div>
          <div class="flex flex-col justify-center gap-1.5 rounded-grape bg-longan-700 px-2 inset-ring inset-ring-white/10"><span class="h-1 w-3/4 rounded-orb bg-rambutan-100/30"></span><span class="h-1 w-1/2 rounded-orb bg-rambutan-100/15"></span></div>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Surfaces</h3>
        <p class="text-body-sm text-rambutan-400">Separate content with space or surfaces</p>
      </a>
      <a href="/spacing" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-1" aria-hidden="true">
          <span class="h-4 w-1.5 rounded-seed bg-persimmon-500/40"></span>
          <span class="h-4 w-2 rounded-seed bg-persimmon-500/40"></span>
          <span class="h-4 w-4 rounded-seed bg-persimmon-500/40"></span>
          <span class="h-4 w-6 rounded-seed bg-persimmon-500/40"></span>
          <span class="h-4 w-8 rounded-seed bg-persimmon-500/40"></span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Spacing</h3>
        <p class="text-body-sm text-rambutan-400">Spacing for each layout</p>
      </a>
      <a href="/motion" class={tile}>
        <div class="mb-4 h-8 flex items-center" aria-hidden="true">
          <span class="relative h-2 w-full rounded-orb bg-white/5">
            <span class="absolute inset-y-0 left-0 w-3 rounded-orb bg-persimmon-500 transition-[left] duration-standard ease-standard motion-safe:group-hover:left-[calc(100%-0.75rem)]"></span>
          </span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Motion</h3>
        <p class="text-body-sm text-rambutan-400">Five durations and four easing curves</p>
      </a>
      </div>
    </section>
    <section>
      <h2 class="text-label-sm text-rambutan-500 mb-3">Components</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <a href="/buttons" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-2">
          <span class="inline-flex items-center rounded-grape bg-persimmon-500 px-2.5 py-1 text-button-sm text-longan-950">Primary</span>
          <span class="inline-flex items-center rounded-grape bg-persimmon-500/15 text-persimmon-200 px-2.5 py-1 text-button-sm inset-ring inset-ring-persimmon-400/20">Soft</span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Buttons</h3>
        <p class="text-body-sm text-rambutan-400">Styles for primary and secondary actions</p>
      </a>
      <a href="/badges" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-1.5 flex-wrap">
          <span class="inline-flex rounded-grape bg-pandan-500/15 text-pandan-200 px-2 py-1 text-label-sm inset-ring inset-ring-pandan-400/20">Live</span>
          <span class="inline-flex rounded-grape bg-durian-500/15 text-durian-200 px-2 py-1 text-label-sm inset-ring inset-ring-durian-400/20">Beta</span>
          <span class="inline-flex rounded-grape bg-lychee-500/15 text-lychee-200 px-2 py-1 text-label-sm inset-ring inset-ring-lychee-400/20">New</span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Badges</h3>
        <p class="text-body-sm text-rambutan-400">Status labels in soft and outline styles</p>
      </a>
      <a href="/forms" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-2">
          <span class="block h-6 flex-1 rounded-grape bg-white/5 inset-ring inset-ring-white/10"></span>
          <span class="inline-grid size-4 place-items-center rounded-seed bg-persimmon-500">
            <svg viewBox="0 0 14 14" fill="none" class="size-3 stroke-longan-950"><path d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Forms</h3>
        <p class="text-body-sm text-rambutan-400">Native controls for text and choices</p>
      </a>
      <a href="/overlays" class={tile}>
        <div class="mb-4 h-8 flex items-center" aria-hidden="true">
          <span class="surface-floating flex w-24 flex-col gap-1 rounded-grape p-1">
            <span class="h-1.5 rounded-orb bg-white/10"></span>
            <span class="h-1.5 w-2/3 rounded-orb bg-white/10"></span>
          </span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Overlays</h3>
        <p class="text-body-sm text-rambutan-400">Floating content and stacking order</p>
      </a>
      <a href="/feedback" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-3 text-persimmon-300" aria-hidden="true">
          <span class="spinner size-5"></span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Feedback</h3>
        <p class="text-body-sm text-rambutan-400">Spinners and empty states</p>
      </a>
      <a href="/code" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-1" aria-hidden="true">
          <kbd class="kbd">⌘</kbd><kbd class="kbd">K</kbd>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Code</h3>
        <p class="text-body-sm text-rambutan-400">Code blocks, inline code and keys</p>
      </a>
      <a href="/icons" class={tile}>
        <div class="mb-4 h-8 flex items-center gap-3 text-persimmon-300">
          <svg viewBox="0 0 16 16" fill="currentColor" class="size-4"><path d="M8 2.5a.75.75 0 0 1 .75.75v4h4a.75.75 0 0 1 0 1.5h-4v4a.75.75 0 0 1-1.5 0v-4h-4a.75.75 0 0 1 0-1.5h4v-4A.75.75 0 0 1 8 2.5Z" /></svg>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path d="M10 3a.75.75 0 0 1 .75.75v5.5h5.5a.75.75 0 0 1 0 1.5h-5.5v5.5a.75.75 0 0 1-1.5 0v-5.5h-5.5a.75.75 0 0 1 0-1.5h5.5v-5.5A.75.75 0 0 1 10 3Z" /></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Icons</h3>
        <p class="text-body-sm text-rambutan-400">Heroicons at their native sizes</p>
      </a>
      </div>
    </section>
    <section>
      <h2 class="text-label-sm text-rambutan-500 mb-3">Brand</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <a href="/bruhs" class={tile}>
        <div class="mb-4 h-8 flex items-center">
          <svg viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8">
            <circle cx="300" cy="300" r="300" class="fill-bruh-base" />
            <ellipse cx="198" cy="223" rx="40" ry="10" class="fill-bruh-eye" />
            <ellipse cx="401" cy="223" rx="40" ry="10" class="fill-bruh-eye" />
            <ellipse cx="307" cy="378" rx="120" ry="10" class="fill-bruh-mouth" />
          </svg>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Logo</h3>
        <p class="text-body-sm text-rambutan-400">Three expressions and eight palettes</p>
      </a>
      <a href="/agents" class={tile}>
        <div class="mb-4 h-8 flex items-end gap-1 font-neon text-rambutan-300 leading-none">
          <span class="text-code-lg">&gt;</span>
          <span class="text-code-lg">adopt</span>
          <span class="text-code-lg text-persimmon-400">bruhs</span>
          <span class="text-code-lg animate-pulse motion-reduce:animate-none">_</span>
        </div>
        <h3 class="text-h3 font-semibold text-rambutan-100 mb-1 group-hover:text-rambutan-50 transition-colors">Agents</h3>
        <p class="text-body-sm text-rambutan-400">Copy the setup guide for your coding agent</p>
      </a>
      </div>
    </section>

  </div>
</BaseLayout>
