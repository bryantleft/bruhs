---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Surfaces">
  <div class="p-6 md:p-8 flex flex-col gap-12 md:gap-16">
    <section>
      <h1 class="text-display-sm font-semibold tracking-tight mb-2 text-balance">Surfaces</h1>
      <p class="text-body-lg text-rambutan-400 max-w-[65ch] text-pretty">
        Start with whitespace to separate content.
        Use a card when content stands alone or has its own interaction.
      </p>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Hierarchy</h2>
      <p class="text-body-sm text-rambutan-400 mb-4">From lightest to heaviest separation.</p>
      <div class="flex flex-col gap-6">
        <div class="p-6">
          <p class="text-eyebrow text-rambutan-500 mb-2">Whitespace only</p>
          <p class="text-body text-rambutan-200">Use space for closely related content. A heading can separate it from supporting text.</p>
        </div>

        <div class="py-6 border-t border-rambutan-100/10">
          <p class="text-eyebrow text-rambutan-500 mb-2">Divider</p>
          <p class="text-body text-rambutan-200">Use a divider between items that share context, such as rows in a list.</p>
        </div>

        <div class="surface-well p-6">
          <p class="text-eyebrow text-rambutan-500 mb-2">Well</p>
          <p class="text-body text-rambutan-200">Use <code class="code-inline">surface-well</code> for recessed or secondary content.</p>
        </div>

        <div class="surface-card p-6">
          <p class="text-eyebrow text-rambutan-500 mb-2">Card</p>
          <p class="text-body text-rambutan-200">Use <code class="code-inline">surface-card</code> for separate or interactive content. Its lighter tone and stronger ring show depth.</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Divided grid</h2>
      <div class="surface-panel overflow-hidden">
        <ul role="list" class="grid grid-cols-1 sm:grid-cols-3">
          <li class="p-6 sm:pr-6 sm:pb-6 sm:pl-6 border-t border-rambutan-100/5 sm:border-t-0 sm:[&:not(:nth-child(3n+1))]:border-l sm:[&:not(:nth-child(3n+1))]:border-rambutan-100/5">
            <p class="text-body-sm text-rambutan-400">Repos</p>
            <p class="text-h2 font-semibold text-rambutan-100 tabular-nums">24</p>
          </li>
          <li class="p-6 border-t border-rambutan-100/5 sm:border-t-0 sm:[&:not(:nth-child(3n+1))]:border-l sm:[&:not(:nth-child(3n+1))]:border-rambutan-100/5">
            <p class="text-body-sm text-rambutan-400">Stars</p>
            <p class="text-h2 font-semibold text-rambutan-100 tabular-nums">1,284</p>
          </li>
          <li class="p-6 border-t border-rambutan-100/5 sm:border-t-0 sm:[&:not(:nth-child(3n+1))]:border-l sm:[&:not(:nth-child(3n+1))]:border-rambutan-100/5">
            <p class="text-body-sm text-rambutan-400">Issues</p>
            <p class="text-h2 font-semibold text-rambutan-100 tabular-nums">7</p>
          </li>
        </ul>
      </div>
    </section>

    <section>
      <h2 class="text-h1 font-semibold tracking-tight mb-6">Rules</h2>
      <div class="flex flex-col gap-3 max-w-[72ch]">
        <p class="text-body text-rambutan-300 text-pretty">Use the lightest separation that makes the content clear. Add a surface only when space or a divider isn't enough.</p>
        <p class="text-body text-rambutan-300 text-pretty">Keep dividers subtle with opacity, as in <code class="code-inline">border-rambutan-100/10</code>.</p>
        <p class="text-body text-rambutan-300 text-pretty">Use <code class="code-inline">surface-card</code> to keep the card tone and ring consistent.</p>
        <p class="text-body text-rambutan-300 text-pretty">Keep wells recessed with a darker or muted tone.</p>
      </div>
    </section>
  </div>
</BaseLayout>
