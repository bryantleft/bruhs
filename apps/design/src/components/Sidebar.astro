---
import BruhLogo from "@/components/BruhLogo.astro";

interface Props {
  current: string;
}

const path = Astro.props.current.replace(/\/$/, "");
const links = [
  { label: "Colors", href: "/colors" },
  { label: "Typography", href: "/typography" },
  { label: "Radius", href: "/radius" },
  { label: "Elevation", href: "/elevation" },
  { label: "Buttons", href: "/buttons" },
  { label: "Badges", href: "/badges" },
  { label: "Forms", href: "/forms" },
  { label: "Icons", href: "/icons" },
  { label: "Surfaces", href: "/surfaces" },
  { label: "Agents", href: "/agents" },
  { label: "Bruhs", href: "/bruhs" },
];
---

<!--
  Below `lg` the sidebar is an off-canvas panel toggled by the menu button. While closed
  it is `invisible`, which also takes its links out of the tab order.
-->
<button
  type="button"
  data-nav-toggle
  aria-controls="site-nav"
  aria-expanded="false"
  aria-label="Open menu"
  class="group fixed top-4 left-4 z-50 rounded-lychee bg-longan-900 p-3 text-rambutan-100/80 inset-ring inset-ring-rambutan-100/10 transition-all duration-300 hover:bg-longan-800 hover:text-rambutan-100 focus-visible:outline-2 focus-visible:outline-persimmon-400 active:scale-95 lg:hidden"
>
  <svg class="size-6 transition-transform duration-300 group-aria-expanded:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path class="group-aria-expanded:hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    <path class="hidden group-aria-expanded:block" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
  </svg>
</button>

<button
  type="button"
  data-nav-backdrop
  tabindex="-1"
  aria-hidden="true"
  class="fixed inset-0 z-40 hidden bg-longan-950/70 lg:hidden"
></button>

<aside
  id="site-nav"
  data-nav
  class="invisible fixed top-0 left-0 z-50 flex h-screen w-64 -translate-x-full flex-col border-r border-rambutan-100/5 bg-longan-950 transition-[translate,visibility] duration-500 ease-out data-open:visible data-open:translate-x-0 lg:visible lg:translate-x-0"
>
  <div class="flex items-center justify-between border-b border-rambutan-100/5 p-5">
    <a href="/" class="flex items-center gap-3 rounded-grape focus-visible:outline-2 focus-visible:outline-persimmon-400">
      <BruhLogo class="size-8 shrink-0" />
      <span
        class:list={[
          "font-krypton text-h4 font-semibold tracking-tighter",
          path === "" ? "text-rambutan-100" : "text-rambutan-100/40 transition-opacity duration-200 hover:text-rambutan-100/70",
        ]}
      >
        Bruhs
      </span>
    </a>
  </div>

  <nav aria-label="Design system" class="flex-1 overflow-y-auto p-5">
    <ul class="space-y-2">
      {links.map((link) => {
        const isActive = link.href === path;
        return (
          <li>
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class="group flex flex-col rounded-lychee p-3 transition-all duration-300 hover:bg-longan-800/30 focus-visible:outline-2 focus-visible:outline-persimmon-400 active:scale-98"
            >
              <span
                class:list={[
                  "mb-1 font-krypton text-h3 font-semibold tracking-tighter transition-all duration-300 sm:text-h2",
                  isActive
                    ? "text-rambutan-100"
                    : "text-rambutan-100/40 group-hover:translate-x-1 group-hover:text-rambutan-100/80",
                ]}
              >
                {link.label}
              </span>
              {isActive && <span class="h-0.5 w-8 rounded-orb bg-persimmon-500"></span>}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<script>
  // Re-bind after every view transition: <ClientRouter /> swaps the body.
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const backdrop = document.querySelector<HTMLButtonElement>("[data-nav-backdrop]");
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!toggle || !backdrop || !nav) return;

    const setOpen = (open: boolean) => {
      nav.toggleAttribute("data-open", open);
      backdrop.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => setOpen(!nav.hasAttribute("data-open")));
    backdrop.addEventListener("click", () => setOpen(false));
    nav.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>
