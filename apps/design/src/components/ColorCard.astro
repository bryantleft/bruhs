---
import CopiedOverlay from "@/components/CopiedOverlay.astro";
import type { ColorGroup } from "@/data/colors";
import { colorToken } from "@/utils/theme-tokens";

interface Props {
  color: ColorGroup;
}

const { color } = Astro.props;
const mainSwatch = color.swatches.find((s) => s.name.endsWith("500"));

// Dark text on light 500s (Durian), light text on dark ones. Read from the token so a
// palette change can't leave a title unreadable.
const mainToken = colorToken(`${color.prefix}-500`);
const lightness = Number(mainToken.match(/^oklch\(([\d.]+)/)?.[1]);
if (Number.isNaN(lightness)) {
  throw new Error(`--color-${color.prefix}-500 is "${mainToken}", expected an oklch() value`);
}
const titleClass = lightness >= 0.6 ? "text-longan-950" : "text-rambutan-50";
---

<div class="overflow-hidden rounded-lychee bg-longan-900 inset-ring inset-ring-rambutan-50/5">
  <div class:list={["flex h-28 items-end px-5 pb-4", mainSwatch?.className]}>
    <h3 class:list={["text-h3 font-semibold", titleClass]} style="font-feature-settings: 'ss01'">{color.name}</h3>
  </div>
  <div class="space-y-4 p-5">
    <p class="text-body-sm text-rambutan-400">{color.description}</p>
    <div class="flex">
      {color.swatches.map((swatch) => {
        const step = swatch.name.split(" ").pop();
        return (
          <button
            type="button"
            data-copy={swatch.variable}
            aria-label={`Copy ${swatch.variable}`}
            class="group/copy flex min-w-0 flex-1 cursor-copy flex-col items-center gap-1.5 rounded-seed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-persimmon-400"
          >
            <span
              class:list={[
                "relative block h-10 w-full transition-[filter] duration-150 group-first/copy:rounded-l-grape group-last/copy:rounded-r-grape group-hover/copy:brightness-110",
                swatch.className,
              ]}
            >
              <CopiedOverlay />
            </span>
            <span
              class:list={[
                "text-code-sm tabular-nums",
                step === "500" ? "font-semibold text-rambutan-100" : "text-rambutan-500",
              ]}
            >
              {step}
            </span>
          </button>
        );
      })}
    </div>
  </div>
</div>
