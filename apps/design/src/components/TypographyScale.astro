---
import CopiedOverlay from "@/components/CopiedOverlay.astro";
import type { TypographyItem } from "@/data/typography";

interface Props {
  items: readonly TypographyItem[];
  title: string;
  description: string;
}

const { items, title, description } = Astro.props;
---

<section>
  <h3 class="text-h3 font-semibold">{title}</h3>
  <p class="mt-1 text-body-sm text-rambutan-400">{description}</p>

  <ul role="list" class="mt-4 divide-y divide-rambutan-100/5 overflow-hidden rounded-lychee bg-longan-900 inset-ring inset-ring-rambutan-100/5">
    {items.map((item) => (
      <li>
        <button
          type="button"
          data-copy={item.className}
          aria-label={`Copy ${item.className}`}
          class="group/copy relative grid w-full cursor-copy gap-x-6 gap-y-2 px-5 py-4 text-left transition-colors hover:bg-longan-800/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-persimmon-400 md:grid-cols-[12rem_minmax(0,1fr)] md:items-center"
        >
          <span class="flex flex-col gap-0.5">
            <code class="text-code text-rambutan-100">{item.className}</code>
            <span class="text-body-sm text-rambutan-400 tabular-nums">{item.size} · {item.weight}</span>
            <span class="text-body-sm text-rambutan-500">{item.usage}</span>
          </span>
          <span class:list={["block truncate text-rambutan-100", item.className, item.mono && "font-mono"]}>
            The quick brown fox jumps over the lazy dog
          </span>
          <CopiedOverlay label />
        </button>
      </li>
    ))}
  </ul>
</section>
