---
import CopiedOverlay from "@/components/CopiedOverlay.astro";
import type { TypographyItem } from "@/data/typography";

interface Props {
  items: readonly TypographyItem[];
  title: string;
  description: string;
}

const { items, title, description } = Astro.props;
---

<section class="space-y-5 md:space-y-6">
  <div>
    <h3 class="mb-2 text-h3 font-semibold">{title}</h3>
    <p class="text-rambutan-400">{description}</p>
  </div>

  <div class="space-y-3 md:space-y-4">
    {items.map((item) => (
      <button
        type="button"
        data-copy={item.className}
        class="group/copy relative w-full cursor-copy rounded-grape border border-rambutan-50/5 bg-longan-900 p-5 text-left transition-transform duration-150 ease-in-out hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-persimmon-400 active:scale-100 md:p-6"
      >
        <code class="absolute top-3 right-3 rounded-seed bg-longan-800 px-2 py-1 font-mono text-label text-rambutan-400 opacity-0 transition-opacity group-hover/copy:opacity-100 group-focus-visible/copy:opacity-100 md:top-4 md:right-4">
          {item.className}
        </code>

        <span class="flex flex-wrap items-center gap-3">
          <span class="text-h4 font-semibold text-rambutan-100">{item.name}</span>
          {item.font && (
            <span class="inline-flex items-center rounded-grape bg-persimmon-500/15 px-2 py-0.5 text-label-sm text-persimmon-200 inset-ring inset-ring-persimmon-400/20">
              {item.font}
            </span>
          )}
        </span>
        <span class="mt-1 flex gap-3 text-body-sm text-rambutan-400 md:gap-4">
          <span>{item.size}</span>
          <span aria-hidden="true">•</span>
          <span>Weight {item.weight}</span>
        </span>

        <span class:list={["block text-rambutan-100", item.className, item.mono && "font-mono"]}>
          The quick brown fox jumps over the lazy dog
        </span>

        <span class="mt-3 block text-body-sm text-rambutan-400">{item.usage}</span>
        <CopiedOverlay label />
      </button>
    ))}
  </div>
</section>
