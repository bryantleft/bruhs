{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "sh scripts/vercel-build.sh",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/privacy/app",
      "destination": "/privacy/#app",
      "permanent": true
    },
    {
      "source": "/privacy/app/",
      "destination": "/privacy/#app",
      "permanent": true
    }
  ]
}
