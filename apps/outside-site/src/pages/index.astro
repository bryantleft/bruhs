---
import {
  getActivity,
  getItem,
  ITEMS,
  LOCATIONS,
  QUESTS,
  SKILLS,
  SKINS,
  type SkinId,
  START_LOCATION,
} from '@outside/src/game/content.ts';
import { createGame, getSkin, locationBlocker, route } from '@outside/src/game/game.ts';
import { MAX_LEVEL } from '@outside/src/game/xp.ts';
import { bruhArt, UI_ART } from '@outside/src/pixel/art.ts';
import { MAP_HEIGHT, MAP_WIDTH, tileCenter } from '@outside/src/pixel/world.ts';
import { palette } from '@outside/src/theme/palette.ts';
import Clouds from '../components/Clouds.astro';
import Header from '../components/Header.astro';
import Report from '../components/Report.astro';
import Ridge from '../components/Ridge.astro';
import StoreBadges from '../components/StoreBadges.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { itemSprite, skillSprite } from '../lib/art';
import { heroSvg, sceneSvg, spriteSvg, worldMapSvg } from '../lib/pixel';
import { SAMPLE_DATE, SAMPLE_STEPS, sampleDay } from '../lib/sample-day';
import { listings, STORES, storeLine, trademarks } from '../lib/stores';

const description =
  "a pixel adventure that runs on walking. your real steps pay for your bruh's travel, skills and quests.";
const town = LOCATIONS.find((place) => place.id === START_LOCATION);
if (!town) throw new Error(`START_LOCATION ${START_LOCATION} is not a place; the hero has no town to draw.`);
// The fruitlands nearest first, by road from the starting town at agility level 1. That is also
// the order the map's places take for keyboard and screen reader users.
const fresh = createGame(SAMPLE_DATE);
const STATIONS = { forge: 'forge: smelt & smith', range: 'range: cook', workbench: 'workbench: craft' } as const;
const places = LOCATIONS.map((place) => {
  const road = route(START_LOCATION, place.id);
  if (!road) throw new Error(`No road from ${START_LOCATION} to ${place.id}; the world map is disconnected.`);
  const activities = place.activities.map((id) => {
    const activity = getActivity(id);
    if (!activity) throw new Error(`${place.id} lists activity "${id}", which is not in the game content.`);
    return activity;
  });
  // What a bruh can gather here, as the app's map panel shows it: the item, its skill and level.
  const finds = activities
    .filter((activity) => !activity.station)
    .map((activity) => {
      const skill = SKILLS.find((entry) => entry.id === activity.skill);
      const item = getItem(activity.output.item);
      return {
        id: activity.id,
        art: itemSprite(activity.output.item),
        skillArt: skillSprite(activity.skill),
        level: activity.level,
        label: `${item?.name}, ${skill?.name ?? activity.skill} level ${activity.level}`,
      };
    });
  const stations = [
    ...new Set(activities.flatMap((activity) => (activity.station ? [STATIONS[activity.station]] : []))),
    ...(place.bank ? ['bank'] : []),
    ...(place.store ? ['general store'] : []),
  ];
  return { place, distance: road.distance, blocker: locationBlocker(fresh, place), finds, stations };
}).sort((a, b) => a.distance - b.distance);
const mapSvg = worldMapSvg({
  label: `map of the fruitlands: ${places.map(({ place }) => place.name).join(', ')}, joined by roads.`,
  home: START_LOCATION,
  locked: new Set(places.filter(({ blocker }) => blocker).map(({ place }) => place.id)),
});
// Matches worldMapSvg's pin colours.
const pinKey: readonly Readonly<{ color: keyof typeof palette; label: string }>[] = [
  { color: 'pandan-300', label: 'you start here' },
  { color: 'durian-400', label: 'town with a bank' },
  { color: 'lychee-400', label: 'wilds' },
  { color: 'rambutan-600', label: 'locked' },
];
// The picked place's pin and panel. CSS only: each place is a radio button, so the map works
// without JavaScript and with arrow keys.
const pickCss = places
  .map(
    ({ place: { id } }) =>
      `.fruitlands:has(#pick-${id}:checked) .pin-${id} .pin-ring, .fruitlands:has(.pin-hit-${id}:hover) .pin-${id} .pin-ring { fill: ${palette['rambutan-50']}; }\n` +
      `.fruitlands:has(#pick-${id}:checked) #detail-${id} { visibility: visible; }`,
  )
  .join('\n');
const pitch =
  'a pixel adventure that runs on walking. your daily steps sync in, and your bruh spends them travelling the fruitlands, chopping, mining, fishing, cooking and crafting.';
const steps = [
  {
    art: UI_ART.steps,
    title: 'walk like you already do',
    body: 'your phone already counts your steps. outside reads the daily total from Apple Health or Health Connect. no workouts to start, nothing to track.',
  },
  {
    art: itemSprite('bronze-axe'),
    title: 'steps pay for everything',
    body: "every trip and every action costs steps. pick a job for your bruh, and the steps you walk keep it going. steps you don't spend wait in your pouch.",
  },
  {
    art: itemSprite('adventurer-chest'),
    title: 'come back to loot',
    body: 'open the app to a report of what your walk paid for: xp, level-ups, drops and the odd treasure chest.',
  },
];
// The party panel's members: four outfits, so it reads as friends, not one bruh.
const PARTY = ['original', 'pandan', 'dragonfruit', 'blueberry'] as const satisfies readonly SkinId[];
const privacy = [
  'outside reads your step totals and never writes to Health.',
  'your game saves on your phone.',
  'your party sees your name, outfit, weekly step total and when you last synced. nothing else.',
  'optional GPS walks stay on your device.',
];
// The official store badges, once a listing is live (src/lib/stores.ts).
const live = listings(STORES);
---

<BaseLayout title="bruhs / outside: a pixel adventure powered by your steps" {description}>
  {/* Top level, so it is the page's banner landmark; it floats over the hero's sky. */}
  <Header overlay />
  <main>
  <section class="hero relative" aria-labelledby="title">
    <div class="sky relative pt-[84px]">
      <Clouds />
      <div class="relative mx-auto grid max-w-5xl grid-cols-1 items-end gap-6 px-5 pb-8 pt-2 md:gap-8 md:pb-10 md:grid-cols-[1fr_1fr] md:pt-8">
        <div class="flex flex-col items-start gap-4">
          <p class="chip label text-pandan-300">{storeLine(STORES)}</p>
          <h1 id="title" class="text-7xl font-bold text-durian-400 outlined-lg sm:text-8xl">outside</h1>
          <p class="text-3xl font-bold text-rambutan-50 outlined sm:text-4xl">touch grass. level up.</p>
          <StoreBadges stores={live} />
        </div>
        <div id="waitlist" class="panel flex scroll-mt-6 flex-col gap-4 p-5">
          {/* Phones show this under the hero instead, so the scene still makes the first screen. */}
          <p class="hidden leading-relaxed text-rambutan-300 md:block">{pitch}</p>
          <WaitlistForm id="hero" stacked />
        </div>
      </div>
    </div>
    <div class="hero-ground" set:html={heroSvg(`your bruh hopping in ${town.name}, a town with houses, an anvil and trees.`)} />
  </section>
  <Ridge from="pandan-500" to="longan-800" />
  <Ridge from="longan-800" to="longan-950" phase={2} />
    <section aria-labelledby="how" class="band bg-longan-950">
      <div class="mx-auto flex max-w-5xl flex-col gap-8 px-5">
        <p class="text-lg leading-relaxed text-rambutan-300 md:hidden">{pitch}</p>
        <h2 id="how" class="text-3xl font-bold text-durian-400 shadowed">how it works</h2>
        <ol class="grid gap-6 md:grid-cols-3">
          {
            steps.map((step, index) => (
              <li class="panel flex flex-col gap-3 p-5">
                <div class="flex items-center gap-3">
                  <span class="well grid size-14 place-items-center" set:html={spriteSvg(step.art, 40)} />
                  <span class="label text-rambutan-500">step {index + 1}</span>
                </div>
                <h3 class="text-xl font-bold text-rambutan-50">{step.title}</h3>
                <p class="leading-relaxed text-rambutan-300">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <Ridge from="longan-950" to="longan-900" phase={4} />
    <section aria-labelledby="day" class="band bg-longan-900">
      <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 md:grid-cols-[1fr_380px]">
        <div class="flex flex-col gap-4">
          <h2 id="day" class="text-3xl font-bold text-durian-400 shadowed">a real first day</h2>
          <p class="max-w-prose text-lg leading-relaxed text-rambutan-300">
            a new bruh walks to {sampleDay.place} and starts chopping. you walk {SAMPLE_STEPS.toLocaleString('en')}
            steps. this is the report you open afterwards, played out by the game's own rules when this page was
            built.
          </p>
          <p class="max-w-prose leading-relaxed text-rambutan-500">
            drops are rolled each action, so your first day will turn up different loot.
          </p>
        </div>
        <Report />
      </div>
    </section>

    <Ridge from="longan-900" to="longan-950" phase={1} />
    <section aria-labelledby="world" class="fruitlands band bg-longan-950">
      <div class="mx-auto flex max-w-5xl flex-col gap-8 px-5">
        <div class="flex flex-col gap-2">
          <h2 id="world" class="text-3xl font-bold text-durian-400 shadowed">the fruitlands</h2>
          <p class="max-w-prose text-lg text-rambutan-300">
            {LOCATIONS.length} places to walk to, from a cosy town to the edge of a fallen star. far places cost
            more steps to reach, and some open only after a quest.
          </p>
          <p class="text-rambutan-500">pick a place on the map to look around.</p>
        </div>
        <div class="grid items-start gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
          <div class="flex flex-col gap-3">
            <fieldset class="world-map relative">
              <legend class="sr-only">pick a place on the map, nearest first</legend>
              <Fragment set:html={mapSvg} />
              {
                places.map(({ place }) => {
                  const { x, y } = tileCenter(place.id);
                  const left = (x / MAP_WIDTH) * 100;
                  const top = (y / MAP_HEIGHT) * 100;
                  const at = `left: ${left}%; top: ${top}%`;
                  return (
                    <>
                      <input
                        type="radio"
                        name="fruitland"
                        id={`pick-${place.id}`}
                        class="pick sr-only"
                        checked={place.id === START_LOCATION}
                        aria-label={place.name}
                        aria-describedby={`detail-${place.id}`}
                      />
                      <label
                        for={`pick-${place.id}`}
                        class:list={[
                          'map-name label',
                          top > 80 && 'map-name-above',
                          left > 75 ? 'map-name-end' : left < 20 ? 'map-name-start' : null,
                        ]}
                        style={at}
                      >
                        {place.name}
                      </label>
                      {/* A second label over the pin itself, so the pin is a target too. */}
                      <label for={`pick-${place.id}`} class={`pin-hit pin-hit-${place.id}`} style={at} aria-hidden="true" />
                    </>
                  );
                })
              }
            </fieldset>
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-rambutan-500">
              {
                pinKey.map((pin) => (
                  <li class="flex items-center gap-2">
                    <span class="pin-swatch" style={`background: ${palette[pin.color]}`} />
                    {pin.label}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="details">
            {
              places.map(({ place, distance, blocker, finds, stations }) => (
                <article id={`detail-${place.id}`} class="detail panel flex flex-col" aria-labelledby={`detail-${place.id}-name`}>
                  <div class="detail-scene" set:html={sceneSvg({ biome: place.biome, skin: 'original' }, { crop: 8 })} />
                  <div class="flex flex-col gap-4 p-5">
                    <div class="flex flex-col gap-1">
                      <p class:list={['label', distance === 0 ? 'text-pandan-300' : 'text-durian-300']}>
                        {distance === 0 ? 'you start here' : `${distance.toLocaleString('en')} steps from ${town.name}`}
                      </p>
                      <h3 id={`detail-${place.id}-name`} class="text-2xl font-bold text-rambutan-50">{place.name}</h3>
                      <p class="leading-relaxed text-rambutan-300">{place.blurb}</p>
                      {blocker ? <p class="leading-relaxed text-lychee-400">{blocker}</p> : null}
                    </div>
                    {finds.length ? (
                      <ul class="flex flex-wrap gap-3">
                        <li class="sr-only">to gather here:</li>
                        {finds.map((find) => (
                          <li class="flex flex-col items-center gap-1" title={find.label}>
                            <span class="sr-only">{find.label}.</span>
                            <span class="well slot" aria-hidden="true" set:html={spriteSvg(find.art, 36)} />
                            <span class="flex items-center gap-1" aria-hidden="true">
                              <Fragment set:html={spriteSvg(find.skillArt, 12)} />
                              <span class="label text-rambutan-500">{find.level}</span>
                            </span>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                    {stations.length ? <p class="text-sm text-rambutan-500">{stations.join(' · ')}</p> : null}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
        <p class="text-sm text-rambutan-500">
          steps are by road from {town.name}. agility levels shorten every road.
        </p>
      </div>
      <style is:inline set:html={pickCss} />
    </section>

    <Ridge from="longan-950" to="longan-900" phase={3} />
    <section aria-labelledby="skills" class="band bg-longan-900">
      <div class="mx-auto grid max-w-5xl gap-10 px-5 md:grid-cols-2">
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <h2 id="skills" class="text-3xl font-bold text-durian-400 shadowed">
              {SKILLS.length} skills to level {MAX_LEVEL}
            </h2>
            <p class="text-lg text-rambutan-300">
              higher levels open better trees, rocks, fish and recipes, and every level makes work take fewer
              steps.
            </p>
          </div>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {
              SKILLS.map((skill) => (
                <li class="well flex items-center gap-3 p-3">
                  <span set:html={spriteSvg(skillSprite(skill.id), 32)} />
                  <span class="flex flex-col">
                    <span class="font-bold text-rambutan-50">{skill.name}</span>
                    <span class="text-sm text-rambutan-500">{skill.blurb}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <h2 class="text-3xl font-bold text-durian-400 shadowed">things to collect</h2>
            <p class="text-lg text-rambutan-300">
              {ITEMS.length} items, {QUESTS.length} quests and {SKINS.length} outfits for your bruh. tools, gear and
              food make every step go further.
            </p>
          </div>
          <ul class="panel grid grid-cols-3 gap-4 p-5 sm:grid-cols-6" aria-label="outfits">
            {
              SKINS.map((skin) => (
                <li class="flex flex-col items-center gap-2 text-center">
                  <span set:html={spriteSvg(bruhArt(skin.id), 48)} />
                  <span class="label text-rambutan-500">{skin.name}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <Ridge from="longan-900" to="longan-950" phase={5} />
    <section class="band bg-longan-950">
      <div class="mx-auto flex max-w-5xl flex-col gap-16 px-5">
        <section aria-labelledby="party" class="grid gap-6 md:grid-cols-2">
          <div class="panel flex flex-col gap-3 p-6">
            <h2 id="party" class="text-2xl font-bold text-durian-400 shadowed">walk with friends</h2>
            <p class="leading-relaxed text-rambutan-300">
              start a party and share its invite code. each week, members race on daily step totals.
            </p>
            <ul class="mt-auto flex items-end gap-3 pt-2" aria-label="a party of bruhs">
              {
                PARTY.map((skin) => (
                  <li set:html={spriteSvg(bruhArt(skin), 48, getSkin(skin).name)} />
                ))
              }
            </ul>
          </div>
          <div class="panel flex flex-col gap-3 p-6">
            <h2 class="text-2xl font-bold text-durian-400 shadowed">your steps, read-only</h2>
            {/* Plain sentences, no bullet markers: the page's text never uses bullets. */}
            {privacy.map((line) => <p class="leading-relaxed text-rambutan-300">{line}</p>)}
          </div>
        </section>

        <section aria-labelledby="join" class="panel grid items-center gap-8 p-6 md:grid-cols-[auto_1fr] md:p-10">
          <span class="hidden md:block" set:html={spriteSvg(bruhArt('pandan'), 128)} />
          <div class="flex flex-col gap-4">
            <h2 id="join" class="text-3xl font-bold text-durian-400 shadowed">be first outside</h2>
            <p class="text-lg text-rambutan-300">join the waitlist and we'll email you when you can play.</p>
            <WaitlistForm id="end" />
          </div>
        </section>
      </div>
    </section>
  </main>
  <footer class="mx-auto flex w-full max-w-5xl flex-col gap-1 border-t-2 border-longan-800 px-5 py-8 text-sm text-rambutan-500">
    <p>outside is in development. features may change before launch.</p>
    <p>
      {/* No ©: the pixel font draws it like a degree sign. */}
      bruhs {new Date().getFullYear()} ·{' '}
      <a href="/privacy/" class="underline underline-offset-4 hover:text-durian-400">privacy</a>
    </p>
    {trademarks(live).map((line) => <p>{line}</p>)}
  </footer>
</BaseLayout>
