---
import Policy, { type Section } from '../../components/Policy.astro';

// The privacy policy App Store Connect and Play Console link to. Keep it true to the app:
// health reads (apps/outside/docs/health-integration.md), GPS walks (src/explore), the party
// upload (src/friends, apps/api/convex/outside.ts) and the map style (src/explore/map.ts).
// Bump when anything below changes.
const UPDATED = '4 November 2026';
const sections: readonly Section[] = [
  {
    title: 'on your phone',
    lines: [
      'your game, your walks and your step history save on your phone, and we never see them.',
      'erase your saved journey in the app and they are gone. deleting the app removes them too.',
    ],
  },
  {
    title: 'your steps',
    lines: [
      'with your permission, outside reads your daily step totals from Apple Health on iPhone or Health Connect on Android. it reads nothing else and never writes to either.',
      "your steps pay for your bruh's travel, skills, missions and quests, worked out on your phone.",
      "step data is never used for ads, never sold, and never shared with anyone except a party you choose to join.",
      "you can turn off access any time in your phone's settings.",
    ],
  },
  {
    title: 'your location',
    lines: [
      'when you start a walk, outside uses your location while the app is open to draw your route and earn distance stamps. it never tracks you in the background.',
      'your routes stay on your phone and are never uploaded.',
      'the map comes from OpenFreeMap. like any website, its servers see your IP address and which map tiles your phone loads, which shows roughly where the map is looking.',
    ],
  },
  {
    title: 'parties',
    lines: [
      'parties are optional. outside works fully without one.',
      "when you create or join one, you agree to share your bruh's name, outfit, daily step totals for the race week, and when you last synced, with everyone in that party.",
      "we store those with Convex, our database host, in the US, under a guest login made for your phone. there's no email, password or real name, and the login stays in your phone's secure storage.",
      'leave the party and your shared step totals are deleted. delete your party profile and your name, outfit and guest login are deleted too.',
      "lost your phone or reinstalled the app? the guest login can't be recovered, so email us your bruh's name and party invite code and we'll delete what was shared.",
    ],
  },
  {
    title: "what we don't do",
    lines: [
      'no ads, no analytics, no tracking across apps or websites, and no selling or sharing your data.',
      'no account, email, contacts or photos needed to play.',
      "outside isn't made for children under 13, and we don't knowingly collect data from them.",
    ],
  },
  {
    title: 'changes',
    lines: ['if anything here changes, we update this page and the date at the top.'],
  },
];
---

<Policy
  title="app privacy · bruhs / outside"
  heading="app privacy"
  description="what the outside app reads, what stays on your phone, and what a party shares."
  path="/privacy/app/"
  updated={UPDATED}
  {sections}
>
  <p slot="intro" class="leading-relaxed text-rambutan-300">
    this covers the outside app on iPhone and Android. the waitlist has <a href="/privacy/" class="link">its own page</a>.
  </p>
</Policy>
