---
import { bruhArt } from '@outside/src/pixel/art.ts';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { spriteSvg } from '../../lib/pixel';
---

<BaseLayout
  title="check your email · bruhs / outside"
  description="confirm your spot on the outside waitlist."
  path="/waitlist/joined/"
  noindex
>
  <Header />
  <main class="mx-auto flex w-full max-w-xl flex-col items-center gap-6 px-5 py-16 text-center">
    <Fragment set:html={spriteSvg(bruhArt('pandan'), 128)} />
    <h1 class="text-4xl font-bold text-durian-400 shadowed">check your email</h1>
    <p class="text-lg text-rambutan-300">
      we sent a link to confirm your spot. it works for 7 days. no email? check spam, or join again in a few minutes.
    </p>
    <a href="/" class="button">back to outside</a>
  </main>
</BaseLayout>
