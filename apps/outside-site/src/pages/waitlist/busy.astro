---
import Header from '../../components/Header.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="try again in a minute · bruhs / outside"
  description="the waitlist is busy right now."
  path="/waitlist/busy/"
  noindex
>
  <Header />
  <main class="mx-auto flex w-full max-w-xl flex-col gap-6 px-5 py-16">
    <h1 class="text-4xl font-bold text-durian-400 shadowed">try again in a minute</h1>
    <div class="panel p-5">
      <WaitlistForm id="retry" error="busy" />
    </div>
  </main>
</BaseLayout>
