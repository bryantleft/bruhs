---
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="removed · bruhs / outside"
  description="your email is off the outside waitlist."
  path="/waitlist/left/"
  noindex
>
  <Header />
  <main class="mx-auto flex w-full max-w-xl flex-col items-center gap-6 px-5 py-16 text-center">
    <h1 class="text-4xl font-bold text-durian-400 shadowed">that email is off the list</h1>
    <p class="text-lg text-rambutan-300">we won't email it. you can join again any time.</p>
    <a href="/" class="button">back to outside</a>
  </main>
</BaseLayout>
