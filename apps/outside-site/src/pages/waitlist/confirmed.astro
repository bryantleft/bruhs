---
import { bruhArt } from '@outside/src/pixel/art.ts';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { spriteSvg } from '../../lib/pixel';
---

<BaseLayout
  title="you're on the list · bruhs / outside"
  description="you're on the outside waitlist."
  path="/waitlist/confirmed/"
  noindex
>
  <Header />
  <main class="mx-auto flex w-full max-w-xl flex-col items-center gap-6 px-5 py-16 text-center">
    <Fragment set:html={spriteSvg(bruhArt('pandan'), 128)} />
    <h1 class="text-4xl font-bold text-durian-400 shadowed">you're on the list</h1>
    <p class="text-lg text-rambutan-300">we'll email you when you can play. until then, keep walking.</p>
    <a href="/" class="button">back to outside</a>
  </main>
</BaseLayout>
