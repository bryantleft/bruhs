---
import { bruhArt } from '@outside/src/pixel/art.ts';
import { spriteSvg } from '../lib/pixel';

// `overlay` floats the bar over the page's first section (the home hero) instead of taking space.
type Props = Readonly<{ overlay?: boolean }>;
const { overlay = false } = Astro.props;
---

<header
  class:list={[
    'mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-5 py-5',
    overlay ? 'absolute inset-x-0 top-0 z-10' : 'relative',
  ]}
>
  <a href="/" class="flex items-center gap-3 text-durian-400 outlined" aria-label="bruhs / outside, home">
    <Fragment set:html={spriteSvg(bruhArt('original'), 32)} />
    <span class="whitespace-nowrap text-lg font-bold">bruhs / outside</span>
  </a>
  {/* Under 400px the long label would wrap beside the logo, so it shortens. */}
  <a href="/#waitlist" aria-label="join the waitlist" class="chip label whitespace-nowrap text-rambutan-100 hover:text-durian-400">
    <span class="min-[400px]:hidden">join</span><span class="hidden min-[400px]:inline">join the waitlist</span>
  </a>
</header>
