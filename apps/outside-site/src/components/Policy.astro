---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';

// A privacy page: plain sentences under short headings, then a way to ask about it. The default
// slot follows the contact section (the waitlist page puts its "remove your email" form there);
// the `intro` slot sits under the title.
export type Section = Readonly<{ title: string; lines: readonly string[] }>;
type Props = Readonly<{
  title: string;
  heading: string;
  description: string;
  path: string;
  updated: string;
  sections: readonly Section[];
}>;
const { title, heading, description, path, updated, sections } = Astro.props;
const CONTACT = 'contact@bruhs.dev';
---

<BaseLayout {title} {description} {path}>
  <Header />
  <main class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-5 py-16">
    <div class="flex flex-col gap-2">
      <h1 class="text-4xl font-bold text-durian-400 shadowed">{heading}</h1>
      <p class="label text-rambutan-500">updated {updated}</p>
      <slot name="intro" />
    </div>
    {
      sections.map((section) => (
        <section class="flex flex-col gap-3">
          <h2 class="text-2xl font-bold text-rambutan-50 shadowed">{section.title}</h2>
          {section.lines.map((line) => (
            <p class="leading-relaxed text-rambutan-300">{line}</p>
          ))}
        </section>
      ))
    }
    <section aria-labelledby="contact" class="flex flex-col gap-3">
      <h2 id="contact" class="text-2xl font-bold text-rambutan-50 shadowed">questions</h2>
      <p class="leading-relaxed text-rambutan-300">
        email <a href={`mailto:${CONTACT}`} class="link">{CONTACT}</a> about your data or anything on this page.
      </p>
    </section>
    <slot />
  </main>
</BaseLayout>
