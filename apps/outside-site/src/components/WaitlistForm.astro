---
import { WAITLIST_MESSAGES } from '../lib/messages';
import { LEAVE_URL, WAITLIST_URL } from '../lib/waitlist';

// `stacked` keeps the field above the button, for narrow columns at any screen width.
// `leave` turns the form into the privacy page's "remove my email" form.
type Props = Readonly<{ id: string; error?: 'invalid' | 'busy'; stacked?: boolean; leave?: boolean }>;
const { id, error, stacked = false, leave = false } = Astro.props;
const ERRORS = { invalid: 'invalid_email', busy: 'rate_limited' } as const;
const label = leave ? 'remove my email' : 'join the waitlist';
---

<form
  method="post"
  action={leave ? LEAVE_URL : WAITLIST_URL}
  data-waitlist={leave ? 'leave' : 'join'}
  class="flex flex-col gap-3"
>
  <label for={`${id}-email`} class="label text-rambutan-300">your email</label>
  <div class:list={['flex flex-col gap-3', !stacked && 'sm:flex-row']}>
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      maxlength="254"
      placeholder="you@example.com"
      aria-invalid={error === 'invalid' ? 'true' : undefined}
      aria-describedby={`${id}-status ${id}-note`}
      class="well min-h-[52px] min-w-0 flex-1 px-4 font-pixel text-lg text-rambutan-50 placeholder:text-longan-500"
    />
    <button type="submit" class="button" data-label={label}>{label}</button>
  </div>
  <!-- Hidden from people and assistive tech; bots that fill it are dropped server-side. -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label>website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p id={`${id}-status`} role="status" class="min-h-6 text-base text-lychee-400" data-status>
    {error ? WAITLIST_MESSAGES[ERRORS[error]] : ''}
  </p>
  <p id={`${id}-note`} class="text-sm text-rambutan-500">
    {
      leave ? (
        "we delete it straight away. you'll get the same reply whether or not it was on the list."
      ) : (
        <>
          we only use it to tell you when outside launches.{' '}
          <a href="/privacy/" class="underline underline-offset-4 hover:text-durian-400">privacy</a>
        </>
      )
    }
  </p>
</form>

<script>
  // Progressive enhancement: without JavaScript the form posts and Convex redirects to a result page.
  import { WAITLIST_MESSAGES as MESSAGES, type WaitlistMessage as Reply } from '../lib/messages';

  // Replies the server names; anything else it refuses is its problem, not the visitor's.
  const SERVER_ERRORS: readonly Reply[] = ['invalid_email', 'rate_limited'];
  function formBody(form: HTMLFormElement): URLSearchParams {
    const body = new URLSearchParams();
    for (const [name, value] of new FormData(form)) if (typeof value === 'string') body.append(name, value);
    return body;
  }
  function replyOf(response: Response, body: unknown, done: Reply): Reply {
    if (response.ok) return done;
    const error = body && typeof body === 'object' && 'error' in body ? body.error : null;
    return SERVER_ERRORS.find((reply) => reply === error) ?? 'server';
  }
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-waitlist]')) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const done: Reply = form.dataset.waitlist === 'leave' ? 'left' : 'joined';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !button || !input) return;
      button.disabled = true;
      button.textContent = done === 'left' ? 'removing…' : 'joining…';
      let reply: Reply = 'offline';
      try {
        // A urlencoded body keeps this a simple CORS request: no preflight round trip.
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formBody(form),
        });
        reply = replyOf(response, await response.json().catch(() => null), done);
      } catch (error) {
        console.error('Waitlist request failed:', error);
      }
      status.textContent = MESSAGES[reply];
      status.classList.toggle('text-lychee-400', reply !== done);
      status.classList.toggle('text-pandan-300', reply === done);
      input.setAttribute('aria-invalid', String(reply === 'invalid_email'));
      button.disabled = false;
      button.textContent = button.dataset.label ?? '';
      if (reply === done) form.reset();
      else input.focus();
    });
  }
</script>
