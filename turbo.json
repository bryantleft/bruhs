{
    "$schema": "https://v2-11-10.turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": [".next/**", "!.next/cache/**", ".vinxi/**", "dist/**"]
      },
      "dev": {
        "persistent": true,
        "cache": false
      },
      "check": {
        "dependsOn": ["^check"]
      }
    }
  }